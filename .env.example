# Prisma — local SQLite database.
# Relative `file:` paths are resolved from prisma/schema.prisma, so ../db/custom.db
# points at <repo>/db/custom.db.
DATABASE_URL="file:../db/custom.db"

# Recommended: Groq Multimodal Vision API (100% Free at https://console.groq.com/keys)
# Blazingly fast (~200ms) Llama-3.2-Vision analysis of text + camera photos
# GROQ_API_KEY=""
# GROQ_MODEL="llama-3.2-11b-vision-preview"

# Alternative: Google Gemini API (https://aistudio.google.com/)
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-1.5-flash"

# Alternative: OpenAI API
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"
