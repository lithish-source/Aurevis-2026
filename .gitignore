!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log

# ── repo hygiene ──
# session artifacts from the build assistant
/tool-results/
# user-uploaded reference material (input, not part of the app)
/upload/
# runtime junk
*.pid
# local SQLite database — regenerate with `bun run db:push`
db/*.db
# local transformer model weights (BERT + YOLO) — downloaded on first run
/.models/
# local backups exported from the sandbox
download/*.zip
download/*.bundle
# Skills directory
/skills/