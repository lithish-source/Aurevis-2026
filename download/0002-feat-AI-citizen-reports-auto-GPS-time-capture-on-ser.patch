+    }
+    console.log(`${tName} "${template}": TYPE ${hits}/${GOLD.length}  ${detail.join(" ")}`);
+  }
+}
+
+for (const [sName, cfg] of Object.entries(SEVS)) {
+  for (const template of TEMPLATES.slice(0, 2)) {
+    let hits = 0;
+    const detail = [];
