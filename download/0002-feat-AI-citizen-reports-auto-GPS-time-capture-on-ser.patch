+      const r = await zero(text, cfg.labels, { multi_label: true, hypothesis_template: template });
+      const idx = cfg.labels.indexOf(r.labels[0]);
+      const got = cfg.keys[idx];
+      if (got === expSev) hits++;
+      detail.push(`${got === expSev ? "✓" : "✗"}${got}`);
+    }
